  "selection": {
    "_commentaire": "Un événement est significatif s'il atteint score_min. Score : log2(1 + domaines distincts) × 2 + source officielle (3 pour une sanction, une mesure commerciale, un conflit, un coup d'État ou une route maritime ; 1 sinon) + 1,5 par pays suivi concerné (au plus 3) + 1 si couvert par GDELT.",
    "score_min": 6,
    "domaines_min_sans_officiel": 3,
    "similarite_min": 0.34
  },

