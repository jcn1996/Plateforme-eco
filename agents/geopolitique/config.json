  "gravite": {
    "_commentaire": "Repères donnés à Gemini et appliqués après sa réponse.",
    "reperes": {
      "1": "déclaration ou procédure de routine (communiqué, réunion, avis technique, discours)",
      "2": "mesure ciblée (sanction visant quelques personnes ou entreprises, droit de douane sur un produit, incident limité)",
      "3": "mesure importante ou tension notable (sanctions sectorielles, hausse de droits de douane sur un pays, frappe ponctuelle, crise politique)",
      "4": "conflit armé, sanctions majeures, rupture commerciale (embargo, fermeture d'une route maritime, offensive militaire)",
      "5": "choc systémique (guerre entre grandes puissances, blocage durable d'une route vitale, crise financière mondiale)"
    },
    "plafonds": {
      "election": {"max": 3, "exceptions": ["disputed result", "disputes the result", "contested result", "contests the result", "refuses to concede", "fraud", "rigged", "violence", "riot", "unrest", "annulled", "annuls", "coup", "martial law", "resultat conteste", "conteste le resultat", "contestation du resultat", "fraude", "violences", "emeute", "annule", "troubles"],
                   "texte": "une élection qui se déroule normalement est au plus en gravité 3 (2 le plus souvent), sauf contestation, violences, ou résultat qui change une politique économique majeure (dans ce dernier cas, l'expliquer dans le résumé)"}
    }
  },

