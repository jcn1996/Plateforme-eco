{
  "_commentaire": "Planificateur. Les plannings (lignes cron) sont lus dans les workflows des agents ; ce fichier ne précise que les paramètres de lancement propres à certains créneaux et les workflows à ignorer.",
  "ignores": ["planificateur.yml", "rattrapage.yml", "analyse-demande.yml"],
  "parametres": {
    "agent-entreprises.yml": {"10 3 * * 6": {"mode": "complet"}, "*": {"mode": "quotidien"}},
    "agent-pays.yml": {"7 2 * * 2-6": {"mode": "flux"}, "*": {"mode": "complet"}},
    "agent-geopolitique.yml": {"3 6 * * *": {"mode": "quotidien"}, "*": {"mode": "horaire"}},
    "agent-risque.yml": {"45 22 * * *": {"mode": "complet"}, "*": {"mode": "horaire"}},
    "agent-inities.yml": {"35 6 * * 0,1": {"mode": "leger"}, "*": {"mode": "complet"}},
    "agent-chef.yml": {"15 7 * * *": {"mode": "complet"}, "45 7 * * *": {"mode": "redaction"}, "*": {"mode": "leger"}},
    "agent-trader.yml": {"33 7 * * 1-5": {"mode": "decision"}, "*": {"mode": "horaire"}}
  },
  "marge_minutes": 2,
  "nouvelle_tentative_minutes": 60,
  "tentatives_max": 2,
  "battement_minutes": 20,
  "panne_minutes": 45
}
